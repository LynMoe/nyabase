# /etc/nyabase/backup.env for nyabase-backup.service (see OPERATIONS.md,
# "Scheduled backups"). No secrets belong here: the dump connects over the
# postgres container's trusted loopback.

# The checkout's deploy/ directory; postgres-ops.sh is taken from it.
NYABASE_DEPLOY_DIR=/opt/nyabase/deploy
# Local staging directory (mode 0700). Not a backup by itself: copy every
# archive off the host with the upload command below.
NYABASE_BACKUP_ROOT=/srv/nyabase-backups
# Local archives older than this many days are deleted after a successful run.
NYABASE_BACKUP_KEEP_DAYS=14
# Executable called with the archive and its .sha256 after verification, e.g.
# a script that copies both to object storage with object lock. A non-zero
# exit fails the run.
#NYABASE_BACKUP_UPLOAD_COMMAND=/usr/local/sbin/nyabase-backup-upload
# Only if the Compose project name was changed from `nyabase`.
#NYABASE_COMPOSE_PROJECT=nyabase
