# Copy this file to .env, replace every CHANGE_ME value, and chmod 0600 .env.
# Keep the service credentials and the URLs below in sync. Passwords embedded
# in URLs must be percent-encoded when they contain reserved URI characters.

# Superuser of the PostgreSQL cluster (role `postgres`), for operators only.
# The Backend never receives it.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER
# The Backend's own role `nyabase`: owns the `nyabase` database, not a
# superuser. Both passwords are applied only when the data volume is created.
NYABASE_DB_PASSWORD=CHANGE_ME_NYABASE_DB
DATABASE_URL=postgresql://nyabase:CHANGE_ME_NYABASE_DB@postgres:5432/nyabase

DB_POOL_MAX=20
PG_APPLICATION_NAME=nyabase-backend
PG_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
PG_READINESS_TIMEOUT_MS=5000
PG_SSL_MODE=disable
PG_SSL_CA_FILE=
PG_SSL_SERVERNAME=
DB_MIGRATIONS_RUN=true
INCUS_PREFLIGHT_IMAGE_ALIAS=
INCUS_PREFLIGHT_IMAGE_FINGERPRINT=
INCUS_PREFLIGHT_EGRESS_URL=
# Setting any of these pins it: the system settings page can no longer change it.
#INCUS_PREFLIGHT_SOURCE_SERVER=https://nyabase-images.nyabase-lxc-images.workers.dev
#INCUS_REQUEST_TIMEOUT_MS=10000
#INCUS_OPERATION_WAIT_TIMEOUT_MS=120000

# The edge bridge the loopback publish is forwarded from. TRUSTED_PROXIES
# defaults to the bridge's own address (.1); change both together.
EDGE_SUBNET=172.30.250.0/24
#TRUSTED_PROXIES=172.30.250.1

BACKEND_CPUS=4.0
BACKEND_MEMORY_LIMIT=2g
BACKEND_PIDS_LIMIT=512
POSTGRES_CPUS=4.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_PIDS_LIMIT=512
POSTGRES_SHM_SIZE=256m
VICTORIAMETRICS_CPUS=4.0
VICTORIAMETRICS_MEMORY_LIMIT=4g
VICTORIAMETRICS_PIDS_LIMIT=512

VM_RETENTION_PERIOD=30d
VM_MIN_FREE_DISK_SPACE_BYTES=5GiB
