[Unit]
Description=Nyabase PostgreSQL logical backup
Documentation=file:/opt/nyabase/deploy/OPERATIONS.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Root, because it drives docker (which is root-equivalent anyway); the dump
# itself runs in a throwaway container without capabilities. Settings and the
# optional off-host upload command come from the environment file.
EnvironmentFile=/etc/nyabase/backup.env
ExecStart=/usr/local/sbin/nyabase-backup
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
UMask=0077
