# ─────────────────────────────────────────────────────────────────
# Stage 1 – builder: install dependencies and compile the control plane
# ─────────────────────────────────────────────────────────────────
FROM node:22-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS builder
WORKDIR /app

# Build tools required for native modules (argon2) and Rust proxy builds
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ musl-tools \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9.15.0 --no-update-notifier

# ── Restore dependencies (cached until manifests or lockfile change) ──
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/common/package.json   packages/common/
COPY packages/backend/package.json  packages/backend/
COPY packages/frontend/package.json packages/frontend/
COPY extensions ./extensions
RUN pnpm install --frozen-lockfile

# ── Compile the backend and bundled frontend in dependency order ──
COPY tsconfig.base.json ./
COPY packages/common    packages/common
COPY packages/backend   packages/backend
COPY packages/frontend  packages/frontend
RUN pnpm --filter @nyabase/common     build && \
    pnpm --filter "./extensions/*"    build && \
    pnpm --filter @nyabase/frontend   build && \
    pnpm --filter @nyabase/backend    build

# Create a self-contained production deployment:
# resolves workspace deps and retains only production node_modules
# (native .node binaries are copied from the already-installed store)
RUN pnpm --filter @nyabase/backend deploy --prod /deploy \
 && for pkg in /app/extensions/*; do \
      [ -d "$pkg/dist" ] || continue; \
      name=$(basename "$pkg"); \
      dest="/deploy/node_modules/@nyabase/$name"; \
      mkdir -p "$dest"; \
      cp -a "$pkg/dist" "$dest/dist"; \
    done

# ─────────────────────────────────────────────────────────────────
# Stage 2 – runner: minimal production image (~no build tools)
# ─────────────────────────────────────────────────────────────────
FROM node:22-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runner
WORKDIR /app

# Runtime SSH identities are generated by the production Backend via
# ssh-keygen; keep the required binary in the otherwise minimal runner image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nyabase \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin nyabase

# Production node_modules with compiled native binaries. Source-tree files can
# legitimately be mode 0600 in a secure checkout, so runner ownership must be
# explicit for the unprivileged application identity.
COPY --chown=10001:10001 --from=builder /deploy .

# pnpm deploy respects .gitignore and therefore omits dist/ directories;
# overlay the compiled TypeScript output explicitly.
COPY --chown=10001:10001 --from=builder /app/packages/backend/dist          ./dist
COPY --chown=10001:10001 --from=builder /app/packages/common/dist           ./node_modules/@nyabase/common/dist

# Bundle the Vite-compiled frontend; NestJS serves it as static assets
# at process.cwd()/public (→ /app/public) with SPA fallback.
COPY --chown=10001:10001 --from=builder /app/packages/frontend/dist         ./public
ENV NODE_ENV=production
EXPOSE 3001

USER 10001:10001
CMD ["node", "dist/main.js"]
