# /etc/nyabase/ssh-proxy.env for deploy/nyabase-ssh-proxy.service.
# Install with: sudo install -m 0600 -o root -g root ssh-proxy.env.example /etc/nyabase/ssh-proxy.env
# systemd reads this file as root before starting the unprivileged service.

# Control WebSocket. Must be wss:// (TLS edge in front of the Backend); ws:// is
# accepted only for a loopback host (localhost, 127.0.0.0/8, ::1) and the proxy
# refuses to start otherwise. Default: ws://127.0.0.1:3000/ws/ssh-proxy (wrong
# port for this product, which listens on 3001).
NYABASE_BACKEND_WS=wss://nyabase.example.com/ws/ssh-proxy
# Optional private CA bundle (PEM, CA certificates only, world-readable). When
# set it REPLACES the bundled public roots and requires a wss:// URL.
#NYABASE_BACKEND_CA_FILE=/etc/nyabase/backend-ca.pem

# Same value as ssh.proxyToken in the Backend config.yaml: 32-1024 ASCII
# letters, digits, '_' or '-'. Exactly one of SSH_PROXY_TOKEN and
# SSH_PROXY_TOKEN_FILE. A token file must be a regular file (not a symlink)
# owned by the service user with no group/other bits, e.g. via a systemd
# LoadCredential= drop-in.
SSH_PROXY_TOKEN=CHANGE_ME
#SSH_PROXY_TOKEN_FILE=

# Jump listener; keep it in sync with ssh.proxyPublicPort. Default 0.0.0.0:2222.
NYABASE_SSH_LISTEN=0.0.0.0:2222

# Connection limits. IPv6 clients are bucketed per /64 and each /48 is capped
# as a whole. Defaults shown. All 1..1024; the pre-auth cap (connections not
# yet authenticated) must not exceed NYABASE_SSH_MAX_CONNECTIONS.
#NYABASE_SSH_MAX_CONNECTIONS=512
#NYABASE_SSH_MAX_CONNECTIONS_PER_IP=16
#NYABASE_SSH_MAX_CONNECTIONS_PER_IPV6_48=64
# One source may use its whole per-IP total of the pre-auth pool while it has
# room; when it is full, a lighter source evicts the heaviest source's oldest one.
#NYABASE_SSH_MAX_PREAUTH_CONNECTIONS=128
# From accept to successful public-key authentication (1000..600000),
# independent of the 600s session inactivity timeout.
#NYABASE_SSH_AUTH_TIMEOUT_MS=30000

# Keep serving the last snapshot while the Backend is unreachable (180000..600000).
#NYABASE_SSH_CONTROL_HOLD_MS=300000

# Default: <HOSTNAME or ssh-proxy>-<pid>-<start ms>.
#NYABASE_SSH_PROXY_ID=
#NYABASE_SSH_ROUTE_CONNECT_TIMEOUT_MS=10000
#NYABASE_BACKEND_RECONNECT_MS=2000
#NYABASE_SSH_STATUS_INTERVAL_MS=1000
