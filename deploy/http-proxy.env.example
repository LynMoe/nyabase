# /etc/nyabase/http-proxy.env for deploy/nyabase-http-proxy.service.
# Install with: sudo install -m 0600 -o root -g root http-proxy.env.example /etc/nyabase/http-proxy.env
# systemd reads this file as root before starting the unprivileged service.

# Control WebSocket. Must be wss:// (TLS edge in front of the Backend); ws:// is
# accepted only for a loopback host (localhost, 127.0.0.0/8, ::1) and the proxy
# refuses to start otherwise. Default: ws://127.0.0.1:3000/ws/http-proxy (wrong
# port for this product, which listens on 3001).
NYABASE_BACKEND_WS=wss://nyabase.example.com/ws/http-proxy
# Optional private CA bundle (PEM, CA certificates only, world-readable). When
# set it REPLACES the bundled public roots and requires a wss:// URL.
#NYABASE_BACKEND_CA_FILE=/etc/nyabase/backend-ca.pem

# Same value as http.proxyToken in the Backend config.yaml: 32-1024 ASCII
# letters, digits, '_' or '-'. Exactly one of HTTP_PROXY_TOKEN and
# HTTP_PROXY_TOKEN_FILE. A token file must be a regular file (not a symlink)
# owned by the service user with no group/other bits, e.g. via a systemd
# LoadCredential= drop-in.
HTTP_PROXY_TOKEN=CHANGE_ME
#HTTP_PROXY_TOKEN_FILE=

# Public listeners. Defaults: NYABASE_HTTP_LISTEN=0.0.0.0:8080, HTTPS off.
# Ports below 1024 rely on the unit's CAP_NET_BIND_SERVICE.
NYABASE_HTTP_LISTEN=0.0.0.0:80
NYABASE_HTTPS_LISTEN=0.0.0.0:443

# Connection limits (WebSocket/upgraded connections count too). IPv6 clients
# are bucketed per /64 and each /48 is capped as a whole. Defaults shown.
# All 1..65536; the pending cap (TLS handshake / request head not yet read)
# must not exceed NYABASE_HTTP_MAX_CONNECTIONS.
#NYABASE_HTTP_MAX_CONNECTIONS=4096
#NYABASE_HTTP_MAX_CONNECTIONS_PER_IP=64
#NYABASE_HTTP_MAX_CONNECTIONS_PER_IPV6_48=256
# One source may use its whole per-IP total of the pending pool while it has
# room; when it is full, a lighter source evicts the heaviest source's oldest one.
#NYABASE_HTTP_MAX_PENDING_CONNECTIONS=1024
# Concurrent connections to one upstream container, all its hostnames together
# (1..NYABASE_HTTP_MAX_CONNECTIONS); over it the client gets a 503, so one site
# cannot hold every slot. A saturated container or owner is logged at warn level at most
# once a minute (container_id, binding_id, hostname, refusals since last line).
#NYABASE_HTTP_MAX_CONNECTIONS_PER_CONTAINER=512
# One client (IPv4 address / IPv6 /64) to one container, so a few clients cannot
# fill a site (1..the smaller of the per-IP and per-container caps), and all of
# one user's containers together (per-container cap..NYABASE_HTTP_MAX_CONNECTIONS).
# Both answer 503 when full.
#NYABASE_HTTP_MAX_CONNECTIONS_PER_IP_PER_CONTAINER=32
#NYABASE_HTTP_MAX_CONNECTIONS_PER_OWNER=1024

# Whole request-body budget after the request head (1000..3600000).
#NYABASE_HTTP_BODY_DEADLINE_MS=30000
# Ordinary request closed (client reset) after this long with no bytes either
# way (1000..86400000).
#NYABASE_HTTP_IDLE_TIMEOUT_MS=120000
# Ordinary request's response cut off (client reset) after this long in total,
# counted from the end of the request body (1000..86400000). Upgraded tunnels
# have no total lifetime.
#NYABASE_HTTP_RESPONSE_LIFETIME_MS=1800000
# Upgraded tunnel closed after this long with no bytes either way (1000..86400000).
#NYABASE_HTTP_UPGRADED_IDLE_MS=3600000

# Keep serving the last route snapshot after the control connection drops
# (0..600000; 0 clears routes immediately). Never longer than the snapshot's own
# lease (300s), so the effective hold is at most 300s.
#NYABASE_HTTP_CONTROL_HOLD_MS=300000

#NYABASE_BACKEND_RECONNECT_MS=2000
#NYABASE_HTTP_STATUS_INTERVAL_MS=1000
