[Unit]
Description=nyabase Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nyabase-agent
ExecStart=/opt/nyabase-agent/bin/nyabase-agent --config /etc/nyabase/agent.yaml
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30s
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nyabase-agent

# Volatile runtime directory (removed automatically by systemd)
RuntimeDirectory=nyabase-agent
# Persistent directory for the never-unlinked cross-restart mutation lock.
StateDirectory=nyabase-agent
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
