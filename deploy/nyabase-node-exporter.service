[Unit]
Description=Nyabase node-exporter (read-only HTTPS metrics)
Documentation=file:/opt/nyabase/deploy/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged user. CPU/PSI/sysctl metrics work without root.
# nvidia-smi (GPU display index) typically needs membership in video/render,
# not root; add those groups on GPU hosts. smartctl is omitted when unreadable.
# nft list table bridge incus requires CAP_NET_ADMIN (see AmbientCapabilities);
# unavailability is emitted as nyabase_node_network_nft_available=0.
User=nyabase-node
Group=nyabase-node
EnvironmentFile=/etc/nyabase/node-exporter.env
WorkingDirectory=/opt/nyabase/node-exporter
# Documented package start command: `node dist/main.js`
# (packages/node-exporter/package.json scripts.start). Use Node.js 22+.
ExecStart=/usr/bin/env node dist/main.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/nyabase/node-exporter.env /etc/nyabase/node-exporter

[Install]
WantedBy=multi-user.target
