{
  "name": "@nyabase/nvidia-gpu",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist dist-esm tsconfig.tsbuildinfo && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nyabase/common": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
