    31	export function CreateContainerDialog({ open, onOpenChange, defaultServerId }: Props) {
    32	  const qc = useQueryClient();
    33	  const [form, setForm] = useState({
    34	    serverId: '',
    35	    imageId: '',
    36	    name: '',
    37	    cpuCores: '',
    38	    memGb: '',
    39	    gpuCount: '0',
    40	  });
    41	  const [mounts, setMounts] = useState<MountEntry[]>([]);
    42	  const [sshServerEnabled, setSshServerEnabled] = useState(false);
    43	  const [addMount, setAddMount] = useState<Partial<MountEntry>>({});
    44	  const [dataDirPick, setDataDirPick] = useState<string>('');
    45	  const [showAdvanced, setShowAdvanced] = useState(false);
    46	
    47	  const { data: servers = [] } = useQuery({
    48	    queryKey: ['servers'], queryFn: () => api.get<ServerDto[]>('/servers'),
    49	  });
    50	  const { data: access } = useQuery({
    51	    queryKey: ['me-access'],
    52	    queryFn: () => api.get<EffectiveAccessDto>('/me/access'),
    53	  });
    54	  const { data: allImages = [] } = useQuery({
    55	    queryKey: ['images-active'], queryFn: () => api.get<ImageDto[]>('/images?activeOnly=true'),
    56	  });
    57	  const { data: serverDirs = [] } = useQuery<DataDirDto[]>({
    58	    queryKey: ['data-dirs', form.serverId],
    59	    queryFn: () => api.get<DataDirDto[]>(`/data-dirs?serverId=${form.serverId}`),
    60	    enabled: !!form.serverId,
    61	  });
    62	  const { data: mountSources = [] } = useQuery<MountSourceDto[]>({
    63	    queryKey: ['mount-sources', form.serverId],
    64	    queryFn: () => api.get<MountSourceDto[]>(`/mount-sources?serverId=${form.serverId}`),
    65	    enabled: !!form.serverId,
    66	  });
    67	
    68	  useEffect(() => {
    69	    if (!open) return;
    70	    setMounts([]);
    71	    setSshServerEnabled(false);
    72	    setAddMount({});
    73	    setDataDirPick('');
    74	    setShowAdvanced(false);
    75	    if (defaultServerId) {
    76	      setForm((f) => ({ ...f, serverId: defaultServerId, imageId: '' }));
    77	    } else {
    78	      setForm((f) => ({ ...f, serverId: '', imageId: '' }));
    79	    }
    80	  }, [open, defaultServerId]);
    81	
    82	  // Pre-fill CPU/mem with grant limits when server changes
    83	  useEffect(() => {
    84	    if (!form.serverId || !access) {
    85	      setForm((f) => ({ ...f, cpuCores: '', memGb: '' }));
    86	      return;
    87	    }
    88	    const serverAccess = access.servers.find((s) => s.serverId === form.serverId);
    89	    if (!serverAccess) return;
    90	    setForm((f) => ({
    91	      ...f,
    92	      cpuCores: serverAccess.cpuMillis > 0 ? String(+(serverAccess.cpuMillis / 1000).toFixed(2)) : '',
    93	      memGb: serverAccess.memBytes > 0 ? String(+(serverAccess.memBytes / 1024 ** 3).toFixed(2)) : '',
    94	    }));
    95	  }, [form.serverId, access]);
    96	
    97	  useEffect(() => {
    98	    setDataDirPick('');
    99	    setAddMount({});
   100	  }, [form.serverId]);
   101	
   102	  const { mutate: create, isPending } = useMutation({
   103	    mutationFn: () => {
   104	      const selectedSrv = servers.find((s) => s.id === form.serverId);
   105	      return api.post<OperationRefResponse>('/v2/containers', {
   106	        serverId: form.serverId,
   107	        imageId: form.imageId,
   108	        name: form.name,
   109	        cpuMillis: form.cpuCores ? Math.round(parseFloat(form.cpuCores) * 1000) : undefined,
   110	        memBytes: form.memGb ? Math.round(parseFloat(form.memGb) * 1024 ** 3) : undefined,
   111	        gpuCount: (selectedSrv?.isGpuServer ?? true) ? (parseInt(form.gpuCount) || undefined) : undefined,
   112	        dataDirs: mounts.length > 0 ? mounts : undefined,
   113	        sshServerEnabled: sshServerEnabled ? true : undefined,
   114	      });
   115	    },
   116	    onSuccess: (res) => {
   117	      toast({
   118	        title: '容器创建已排队',
   119	        description: res.operationId ? `操作 ${res.operationId.slice(0, 8)}` : '正在初始化，稍后刷新查看状态',
   120	      });
   121	      qc.invalidateQueries({ queryKey: ['containers'] });
   122	      onOpenChange(false);
   123	    },
   124	    onError: (e) => toast({ title: '创建失败', description: e.message, variant: 'destructive' }),
   125	  });
   126	
   127	  const sourceMap = new Map(mountSources.map((s) => [`${s.kind}:${s.id}`, s]));
   128	
   129	  const formatDataDirLabel = (d: DataDirDto) => {
   130	    const src = sourceMap.get(`${d.sourceKind}:${d.sourceId}`);
   131	    if (src) return `${src.label} / ${d.name}`;
   132	    return `${d.sourceKind === 'local' ? '本地' : '远程'} / ${d.name}`;
   133	  };
   134	
   135	  const mountSourceKey = (m: Pick<MountEntry, 'sourceKind' | 'sourceId' | 'dirName'>) =>
   136	    `${m.sourceKind}:${m.sourceId}:${m.dirName}`;
   137	  const dataDirSourceKey = (d: DataDirDto) => `${d.sourceKind}:${d.sourceId}:${d.name}`;
   138	  const uniqueServerDirs = serverDirs.filter(
   139	    (d, i) => serverDirs.findIndex((x) => dataDirSourceKey(x) === dataDirSourceKey(d)) === i,
   140	  );
