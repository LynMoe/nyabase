    30	
    31	@Injectable()
    32	export class ContainerControlService {
    33	  constructor(
    34	    private dataSource: DataSource,
    35	    private access: AccessResolverService,
    36	    private actions: ContainerActionPolicyService,
    37	    private operations: ContainerOperationService,
    38	    @InjectRepository(ContainerEntity)
    39	    private containersRepo: Repository<ContainerEntity>,
    40	    @InjectRepository(ContainerDesiredSpecEntity)
    41	    private desiredRepo: Repository<ContainerDesiredSpecEntity>,
    42	    @InjectRepository(ContainerLifecycleEntity)
    43	    private lifecycleRepo: Repository<ContainerLifecycleEntity>,
    44	    @InjectRepository(RuntimeContainerEntity)
    45	    private runtimeRepo: Repository<RuntimeContainerEntity>,
    46	    @InjectRepository(OperationEntity)
    47	    private operationsRepo: Repository<OperationEntity>,
    48	    @InjectRepository(ImageEntity)
    49	    private imagesRepo: Repository<ImageEntity>,
    50	    @InjectRepository(ServerEntity)
    51	    private serversRepo: Repository<ServerEntity>,
    52	    @InjectRepository(UserEntity)
    53	    private usersRepo: Repository<UserEntity>,
    54	  ) {}
    55	
    56	  async list(userId: string, filters: { serverId?: string; ownOnly?: boolean } = {}): Promise<ContainerView[]> {
    57	    const canManageAny = await this.access.hasCapability(userId, Capability.ManageContainersAny);
    58	    const where: { serverId?: string; ownerId?: string } = {};
    59	    if (filters.serverId) where.serverId = filters.serverId;
    60	    if (filters.ownOnly || !canManageAny) where.ownerId = userId;
    61	    const containers = await this.containersRepo.find({ where, order: { createdAt: 'DESC' } });
    62	    return this.viewsFor(containers);
    63	  }
    64	
    65	  async get(containerId: string, userId: string): Promise<ContainerView> {
    66	    const container = await this.containersRepo.findOneBy({ id: containerId });
    67	    if (!container || container.deletedAt) throw new NotFoundException('Container not found');
    68	    await this.assertCanRead(userId, container);
    69	    return (await this.viewsFor([container]))[0];
    70	  }
    71	
    72	  async create(userId: string, request: CreateContainerRequest): Promise<OperationRefResponse> {
    73	    const grant = await this.access.resolveServer(userId, request.serverId);
    74	    const canManageAny = await this.access.hasCapability(userId, Capability.ManageContainersAny);
    75	    if (!grant && !canManageAny) throw new ForbiddenException('No server access');
    76	    const allowedImages = canManageAny ? null : await this.access.resolveAllowedImages(userId, request.serverId);
    77	    if (allowedImages && !allowedImages.has(request.imageId)) throw new ForbiddenException('No image access');
    78	    const [image, user, server] = await Promise.all([
    79	      this.imagesRepo.findOneBy({ id: request.imageId }),
    80	      this.usersRepo.findOneBy({ id: userId }),
    81	      this.serversRepo.findOneBy({ id: request.serverId }),
    82	    ]);
    83	    if (!image) throw new NotFoundException('Image not found');
    84	    if (!image.isActive) throw new ForbiddenException('Image is inactive');
    85	    if (!user?.numericId) throw new ForbiddenException('User numeric ID is required for container runtime operations');
    86	    if (!server) throw new NotFoundException('Server not found');
    87	    if (!canManageAny && grant) {
    88	      const requestedCpu = request.cpuMillis ?? grant.cpuMillis ?? 0;
    89	      const requestedMem = request.memBytes ?? grant.memBytes ?? 0;
    90	      const existing = await this.containersRepo.find({ where: { ownerId: userId, serverId: request.serverId } });
    91	      const activeIds = existing.filter((c) => !c.deletedAt).map((c) => c.id);
    92	      const existingSpecs = activeIds.length > 0 ? await this.desiredRepo.find({ where: { containerId: In(activeIds) } }) : [];
    93	      const usedCpu = existingSpecs.reduce((sum, spec) => sum + spec.cpuMillis, 0);
    94	      const usedMem = existingSpecs.reduce((sum, spec) => sum + spec.memBytes, 0);
    95	      if (grant.cpuMillis > 0 && usedCpu + requestedCpu > grant.cpuMillis) throw new ForbiddenException('CPU quota exceeded');
    96	      if (grant.memBytes > 0 && usedMem + requestedMem > grant.memBytes) throw new ForbiddenException('Memory quota exceeded');
    97	      if (request.gpuIndices?.length) {
    98	        if (grant.gpuMode === 'none') throw new ForbiddenException('GPU access denied');
    99	        if (grant.gpuMode === 'indices') {
   100	          const allowed = new Set(grant.gpuIndices);
   101	          if (!request.gpuIndices.every((idx) => allowed.has(idx))) throw new ForbiddenException('GPU index denied');
   102	        }
   103	      }
   104	      for (const dir of request.dataDirs ?? []) {
   105	        if (!await this.access.hasMountSourceAccess(userId, request.serverId, dir.sourceKind, dir.sourceId)) {
   106	          throw new ForbiddenException('Mount source access denied');
   107	        }
   108	      }
   109	    }
   110	
   111	    return this.dataSource.transaction(async (manager) => {
   112	      const now = new Date();
   113	      const containerId = uuidv4();
   114	      const cpuMillis = request.cpuMillis ?? grant?.cpuMillis ?? 0;
   115	      const memBytes = request.memBytes ?? grant?.memBytes ?? 0;
   116	      const gpuIndices = request.gpuIndices ?? [];
   117	      await manager.save(ContainerEntity, manager.create(ContainerEntity, {
   118	        id: containerId,
   119	        serverId: request.serverId,
   120	        ownerId: userId,
   121	        name: request.name,
   122	        imageId: request.imageId,
   123	        createdBy: userId,
   124	        deletedAt: null,
   125	      }));
   126	      await manager.save(ContainerDesiredSpecEntity, manager.create(ContainerDesiredSpecEntity, {
   127	        id: uuidv4(),
   128	        containerId,
   129	        generation: 1,
   130	        imageRef: image.dockerImage,
   131	        imageDefaultUid: image.defaultUid,
   132	        cpuMillis,
   133	        memBytes,
   134	        diskBytes: grant?.diskBytes ?? 0,
   135	        gpuMode: gpuIndices.length > 0 ? 'indices' : 'none',
   136	        gpuIndices,
   137	        mountsJson: request.dataDirs ?? [],
   138	        sshEnabled: request.sshServerEnabled === true,
   139	        powerIntent: ContainerPowerIntent.Running,
   140	        entrypointJson: image.entrypoint ? image.entrypoint.split(/\s+/).filter(Boolean) : null,
