     1	import { Link, useNavigate } from '@tanstack/react-router';
     2	import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
     3	import { useState, useEffect } from 'react';
     4	import { api } from '../lib/api.js';
     5	import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card.js';
     6	import { Badge } from '../components/ui/badge.js';
     7	import { Button } from '../components/ui/button.js';
     8	import { Input } from '../components/ui/input.js';
     9	import { Label } from '../components/ui/label.js';
    10	import { Progress } from '../components/ui/progress.js';
    11	import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '../components/ui/dialog.js';
    12	import { toast } from '../hooks/use-toast.js';
    13	import { formatBytes, relativeTime } from '../lib/utils.js';
    14	import { Plus, Server, RefreshCw } from 'lucide-react';
    15	import { Capability } from '@nyabase/common';
    16	import type { ServerDto } from '@nyabase/common';
    17	import { useAuthStore } from '../store/auth.js';
    18	
    19	export default function ServersPage() {
    20	  const { user } = useAuthStore();
    21	  const navigate = useNavigate();
    22	  const canManage = user?.capabilities.includes(Capability.ManageServers) ?? false;
    23	
    24	  useEffect(() => {
    25	    if (user && !canManage) {
    26	      navigate({ to: '/', replace: true });
    27	    }
    28	  }, [user, canManage, navigate]);
    29	
    30	  const [showCreate, setShowCreate] = useState(false);
    31	  const { data: servers = [], isLoading, isFetching, refetch } = useQuery({
    32	    queryKey: ['servers'],
    33	    queryFn: () => api.get<ServerDto[]>('/servers'),
    34	    refetchInterval: 15_000,
    35	  });
    36	
    37	  if (!canManage) return null;
    38	
    39	  return (
    40	    <div className="p-6 space-y-4 w-full">
    41	      <div className="flex items-center justify-between">
    42	        <div>
    43	          <h1 className="text-2xl font-semibold tracking-tight">服务器</h1>
    44	          <p className="text-muted-foreground text-sm">{servers.length} 台已注册</p>
    45	        </div>
    46	        <div className="flex items-center gap-2">
    47	          <Button variant="ghost" size="icon" className="h-8 w-8 text-muted-foreground" onClick={() => refetch()} disabled={isFetching}>
    48	            <RefreshCw className={`h-4 w-4 ${isFetching ? 'animate-spin' : ''}`} />
    49	          </Button>
    50	          <Button onClick={() => setShowCreate(true)}>
    51	            <Plus className="h-4 w-4" />添加服务器
    52	          </Button>
    53	        </div>
    54	      </div>
    55	
    56	      {isLoading ? (
    57	        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
    58	          {[1, 2].map((i) => <Card key={i}><CardContent className="h-36 animate-pulse bg-muted/50 rounded-lg mt-6" /></Card>)}
    59	        </div>
    60	      ) : servers.length === 0 ? (
    61	        <Card>
    62	          <CardContent className="flex flex-col items-center justify-center py-12 space-y-3">
    63	            <Server className="h-10 w-10 text-muted-foreground/40" />
    64	            <p className="text-sm text-muted-foreground">还没有服务器</p>
    65	            <Button size="sm" onClick={() => setShowCreate(true)}>
    66	              <Plus className="h-4 w-4" />添加服务器
    67	            </Button>
    68	          </CardContent>
    69	        </Card>
    70	      ) : (
    71	        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
    72	          {servers.map((s) => <ServerCard key={s.id} server={s} />)}
    73	        </div>
    74	      )}
    75	
    76	      <CreateServerDialog open={showCreate} onOpenChange={setShowCreate} />
    77	    </div>
    78	  );
    79	}
    80	
    81	function ServerCard({ server: s }: { server: ServerDto }) {
    82	  const online = s.status === 'online';
    83	  const disks = s.disks ?? [];
    84	  const gpus = s.gpus ?? [];
    85	  const totalDisk = disks.reduce((a, d) => a + d.totalBytes, 0);
    86	  const usedDisk = disks.reduce((a, d) => a + d.usedBytes, 0);
    87	  const diskPct = totalDisk > 0 ? (usedDisk / totalDisk) * 100 : 0;
    88	
    89	  return (
    90	    <Link to="/servers/$id" params={{ id: s.id }}>
    91	      <Card className="hover:bg-accent/50 transition-colors cursor-pointer h-full">
    92	        <CardHeader className="pb-2">
    93	          <div className="flex items-center justify-between">
    94	            <CardTitle className="text-base">{s.name}</CardTitle>
    95	            <Badge variant={online ? 'success' : 'secondary'}>{s.status}</Badge>
    96	          </div>
    97	          <CardDescription className="font-mono text-xs">{s.ipCidr}</CardDescription>
    98	        </CardHeader>
    99	        <CardContent className="space-y-2">
   100	          {gpus.length > 0 && (
   101	            <div className="flex flex-wrap gap-1">
   102	              {gpus.map((g) => (
   103	                <Badge key={g.index} variant="secondary" className="text-xs">
   104	                  GPU {g.index}: {g.model.replace('NVIDIA ', '')}
   105	                </Badge>
   106	              ))}
   107	            </div>
   108	          )}
   109	          {totalDisk > 0 && (
   110	            <div className="space-y-1">
   111	              <div className="flex justify-between text-xs text-muted-foreground">
   112	                <span>磁盘</span>
   113	                <span>{formatBytes(usedDisk)} / {formatBytes(totalDisk)}</span>
   114	              </div>
   115	              <Progress value={diskPct} className="h-2" />
   116	            </div>
   117	          )}
   118	          <p className="text-xs text-muted-foreground">最近活跃 {relativeTime(s.lastSeenAt)}</p>
   119	        </CardContent>
   120	      </Card>
   121	    </Link>
   122	  );
   123	}
