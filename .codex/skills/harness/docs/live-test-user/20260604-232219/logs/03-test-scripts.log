if (!nfsServer) throw new Error('NYABASE_MOUNT_NFS_SERVER must be set in test/config/local.env or env');
if (!nfsExport) throw new Error('NYABASE_MOUNT_NFS_EXPORT must be set in test/config/local.env or env');

