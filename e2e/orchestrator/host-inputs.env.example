# Copy to a private env file. Do not put secrets in git.
# Required for e2e.sh up + the API runner. Profiles are smoke, core, and full only.
# Smoke is API-only (00-foundation + 15-iam) and does not need spoof/outage mutation.
# Local cluster facts (Ceph nbdev-test, GPU peer, nyabase-test-1) live in gitignored /lab/.

E2E_BASE_URL=https://nyabase.example.test
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
NYABASE_CONFIG_FILE=/path/to/nyabase.yaml
E2E_EDGE_CA_FILE=/path/to/edge-ca.pem
E2E_DATABASE_URL=postgresql://nyabase:nyabase@127.0.0.1:5432/nyabase

E2E_INCUS_API_ENDPOINT=https://127.0.0.1:8443
E2E_INCUS_SERVER_CERT_FINGERPRINT=
E2E_INCUS_CLIENT_CERT=/path/to/incus-client.crt
E2E_INCUS_CLIENT_KEY=/path/to/incus-client.key
E2E_INCUS_CA_FILE=/path/to/incus-ca.pem
E2E_INCUS_TRUST_TOKEN=

E2E_INCUS_DIR_POOL=e2e-dir
E2E_INCUS_LVM_POOL=e2e-lvm
E2E_INCUS_DIR_QUOTA_PROOF=1
E2E_INCUS_LVM_BLOCK_PROOF=1
E2E_INCUS_PARENT_INTERFACE=vmbr0
E2E_INCUS_ROUTED_SUBNET=192.168.10.0/24
E2E_INCUS_ROUTED_ADDRESS=192.168.10.2
E2E_INCUS_ROUTED_GATEWAY=192.168.10.1
E2E_INCUS_PROBE_ADDRESS=192.168.10.3

E2E_INCUS_IMAGE_SOURCE_URL=https://images.example.test
E2E_INCUS_IMAGE_REMOTE=e2e
E2E_INCUS_IMAGE_ALIAS=debian-sshd
E2E_INCUS_IMAGE_FINGERPRINT=
E2E_INCUS_IMAGE_NO_DHCP=1
E2E_INCUS_PREFLIGHT_IMAGE_ALIAS=debian-sshd
E2E_INCUS_PREFLIGHT_IMAGE_FINGERPRINT=
E2E_INCUS_PREFLIGHT_POOL_NAME=e2e-dir
E2E_INCUS_PREFLIGHT_EGRESS_URL=https://example.test
E2E_INCUS_PREFLIGHT_SOURCE_SERVER=https://images.example.test

E2E_NODE_EXPORTER_URL=https://127.0.0.1:9100
E2E_NODE_EXPORTER_TOKEN=
E2E_NODE_EXPORTER_SERVER_CERT_FINGERPRINT=
E2E_SSH_PRIVATE_KEY_FILE=/path/to/id_ed25519
E2E_SSH_KNOWN_HOSTS=/path/to/known_hosts
E2E_SSH_USER=debian
E2E_BACKEND_AUTOSTART=1

# core / full only
# E2E_INCUS_SPOOF_ADDRESS=192.168.10.250
# E2E_ENABLE_NETWORK_MUTATION=1
# E2E_ENABLE_OUTAGE_MUTATION=1
# E2E_NODE_EXPORTER_UNIT=nyabase-node-exporter.service
