NFS_CORE_PARAM {
    Protocols = 4;
    NFS_Port = 2049;
    Enable_UDP = false;
}

NFSv4 {
    Graceless = true;
    RecoveryBackend = fs_ng;
    Minor_Versions = 1, 2;
}

EXPORT_DEFAULTS {
    Access_Type = None;
}

EXPORT {
    Export_Id = 1;
    Path = /srv/export;
    Pseudo = /nyabase;
    Access_Type = RW;
    Squash = No_Root_Squash;
    Protocols = 4;
    Transports = TCP;
    SecType = sys;

    FSAL {
        Name = VFS;
    }

    CLIENT {
        Clients = @CLIENT_CIDR@;
        Access_Type = RW;
        Squash = No_Root_Squash;
    }
}
