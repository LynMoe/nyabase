# Inputs for tests/e2e/e2e.sh. Copy to tests/e2e/lab.env (git-ignored) and fill in.
# Plain KEY=value lines, sourced by bash: quote values that contain spaces.
# Nothing secret belongs here: the run generates its own secrets, and the lab
# hosts are reached with the ssh keys of the user running e2e.sh.

# --- Where the control plane runs (this machine) ---------------------------------
# PostgreSQL server URL WITHOUT a database name. `up` creates nyabase_e2e_<run id>
# there and `down` drops it. The role needs CREATEDB.
E2E_PG_URL=postgresql://postgres:postgres@127.0.0.1:55432
# Run state (state.json, secrets, logs, pid files) lives in $E2E_RUN_ROOT/<run id>.
#E2E_RUN_ROOT=/var/tmp/nyabase-e2e
# Address and ports of the three processes. The lab hosts' guests must be
# reachable from this machine (the ssh-proxy and http-proxy dial them).
E2E_LISTEN_HOST=127.0.0.1
E2E_BACKEND_PORT=13001
E2E_SSH_PROXY_PORT=12222
E2E_HTTP_PROXY_PORT=18080
# Set to 1 to skip `pnpm build` / `cargo build` when the outputs are current.
#E2E_SKIP_BUILD=0

# --- Image -----------------------------------------------------------------------
# Catalog alias to register and pull onto every server, and where to pull it from.
E2E_IMAGE_ALIAS=ubuntu/24.04
E2E_IMAGE_SOURCE_URL=https://nyabase-images.nyabase-lxc-images.workers.dev
# Combined fingerprint of that baked image (required by server preflight) and an
# HTTPS URL the preflight probe instance must be able to reach.
E2E_PREFLIGHT_IMAGE_FINGERPRINT=650e07d8f27156d0399c086145cfae740b820108ffbed9c0999231e470f955b3
E2E_PREFLIGHT_EGRESS_URL=https://example.com/
# Root disk size of test containers, in GiB.
E2E_ROOT_SIZE_GIB=8

# --- LAN the guests live on (bridged on each server's parent interface) -----------
E2E_IP_CIDR=192.168.0.0/16
# The slice of the LAN the run may hand out to guests; keep it clear of real hosts.
E2E_IP_ALLOCATION_CIDR=192.168.255.0/24
E2E_IP_GATEWAY=192.168.0.1
# Comma-separated addresses inside E2E_IP_CIDR that must never be allocated.
E2E_IP_RESERVED=192.168.1.10,192.168.1.11,192.168.1.12
# A free address for the preflight probe instance (outside the allocation slice is fine).
E2E_PROBE_ADDRESS=192.168.255.254

# --- Incus servers to register ------------------------------------------------------
# Space-separated indexes; each needs the E2E_SERVER_<n>_* block below. One server
# runs everything except the shared-volume scenario (needs two with a shared pool)
# and the second-server image removal check.
E2E_SERVERS="1 2"

# SSH target of the lab host, used to mint the one-time trust token (`incus config
# trust add`) and, on `down`, to delete what the run created. `local` = this machine.
E2E_SERVER_1_SSH=root@lab-1.example
# Incus API endpoint the control plane dials (https, mTLS); its certificate is read
# with `openssl s_client` at `up` and pinned.
E2E_SERVER_1_API=https://lab-1.example:8443
# Unmanaged Linux bridge on the host that guest NICs attach to, and guest DNS servers.
E2E_SERVER_1_PARENT=vmbr0
E2E_SERVER_1_DNS=8.8.8.8
# Incus storage pool for root disks and local volumes (must support quotas, not CephFS).
E2E_SERVER_1_POOL=default
# Optional: Incus name of the CephFS pool on this host that maps to the shared backend.
E2E_SERVER_1_SHARED_POOL=cephfs-lab
# Optional: PCI address of a GPU on this host; enables the GPU scenario and the GPU part of the merge scenario.
#E2E_SERVER_1_GPU_PCI=0000:81:00.0

E2E_SERVER_2_SSH=root@lab-2.example
E2E_SERVER_2_API=https://lab-2.example:8443
E2E_SERVER_2_PARENT=vmbr0
E2E_SERVER_2_DNS=8.8.8.8
E2E_SERVER_2_POOL=default
E2E_SERVER_2_SHARED_POOL=cephfs-lab

# --- Shared (CephFS) backend, optional ----------------------------------------------
# Leave E2E_SHARED_IDENTITY_KEY empty to skip the shared-volume scenario.
# identity key: cephfs:<ceph cluster name>/<pool source>/<path without leading slash>
# (as derived from the Incus pool's cephfs.cluster_name, source and cephfs.path).
E2E_SHARED_IDENTITY_KEY=
# fsid of the Ceph cluster, and the capacity overcommit ratio (1 = none).
E2E_SHARED_CEPH_FSID=
E2E_SHARED_OVERCOMMIT=1
