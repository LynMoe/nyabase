{
  "name": "@nyabase/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/persistence-pg && cp -R src/persistence-pg/migrations dist/persistence-pg/migrations",
    "dev": "tsx watch src/main.ts",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "migration:run": "tsx src/persistence-pg/cli.ts migrate",
    "migration:status": "tsx src/persistence-pg/cli.ts status",
    "incus:generate-api-types": "node src/incus/generate-api-types.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/platform-ws": "^11.2.0",
    "@nestjs/websockets": "^11.2.0",
    "@nyabase/common": "workspace:*",
    "argon2": "^0.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "kysely": "^0.28.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.2",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "dotenv": "^17.4.2",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0"
  }
}
