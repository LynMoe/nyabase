{
  "name": "@nyabase/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -b && rm -rf dist/platform/persistence-pg/migrations && mkdir -p dist/platform/persistence-pg && cp -R src/platform/persistence-pg/migrations dist/platform/persistence-pg/migrations",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=4",
    "migration:run": "tsx src/platform/persistence-pg/cli.ts migrate",
    "migration:status": "tsx src/platform/persistence-pg/cli.ts status",
    "incus:generate-api-types": "node src/incus/generate-api-types.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-ws": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "@nyabase/common": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.9",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
