{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "paths": {
      "@nyabase/common": ["../common/dist/index"],
      "@nyabase/nvidia-gpu": ["../../extensions/nvidia-gpu/dist/index"]
    }
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true,
    "experimentalResolver": true,
    "require": ["tsconfig-paths/register"]
  }
}
