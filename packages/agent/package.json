{
  "name": "@nyabase/agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nyabase/common": "workspace:*",
    "async-mutex": "^0.5.0",
    "dockerode": "^4.0.4",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.38",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0"
  }
}
