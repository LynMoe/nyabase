{
  "name": "nyabase",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.14.4",
      "brace-expansion": "2.1.2",
      "file-type": "21.3.2",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "postcss": "8.5.18",
      "protobufjs": "7.6.5",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "seroval": "1.6.8",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "build": "pnpm --filter @nyabase/node-exporter build && pnpm --filter @nyabase/frontend build && pnpm --filter @nyabase/backend build",
    "build:node-exporter": "pnpm --filter @nyabase/node-exporter build",
    "build:frontend": "pnpm --filter @nyabase/frontend build",
    "dev:backend": "pnpm --filter @nyabase/backend dev",
    "dev:frontend": "pnpm --filter @nyabase/frontend dev",
    "dev:node-exporter": "pnpm --filter @nyabase/node-exporter dev",
    "lint": "eslint --max-warnings 0 packages/common/src packages/node-exporter/src packages/backend/src packages/frontend/src",
    "typecheck": "tsc -b packages/backend packages/node-exporter && pnpm --filter @nyabase/frontend typecheck",
    "test:unit": "pnpm --filter @nyabase/common test && pnpm --filter @nyabase/node-exporter test && pnpm --filter @nyabase/backend test && pnpm --filter @nyabase/frontend test",
    "test": "pnpm typecheck && pnpm test:unit",
    "check": "bash scripts/check.sh",
    "check:backend-bootstrap": "pnpm --filter @nyabase/backend build && node scripts/check-backend-bootstrap.mjs",
    "check:rust-proxies": "bash scripts/check-rust-proxies.sh",
    "e2e:validate": "pnpm --dir tests/e2e validate",
    "e2e:check": "pnpm --dir tests/e2e install --frozen-lockfile --ignore-workspace && pnpm --dir tests/e2e typecheck && node --test tests/e2e/orchestrator/*.contract.test.mjs",
    "e2e:preflight": "bash tests/e2e/orchestrator/e2e.sh preflight",
    "e2e:doctor": "bash tests/e2e/orchestrator/e2e.sh doctor",
    "e2e:build": "bash tests/e2e/orchestrator/e2e.sh build",
    "e2e:up": "bash tests/e2e/orchestrator/e2e.sh up",
    "e2e:health": "bash tests/e2e/orchestrator/e2e.sh health",
    "e2e:down": "bash tests/e2e/orchestrator/e2e.sh down",
    "e2e:replay": "bash tests/e2e/orchestrator/e2e.sh replay",
    "test:e2e:smoke": "bash tests/e2e/orchestrator/e2e.sh run smoke",
    "test:e2e:core": "bash tests/e2e/orchestrator/e2e.sh run core",
    "test:e2e:full": "bash tests/e2e/orchestrator/e2e.sh run full",
    "test:e2e:release": "bash tests/e2e/orchestrator/e2e.sh release"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
