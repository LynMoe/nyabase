{
  "name": "nyabase",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.14.4",
      "brace-expansion": "2.1.2",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "protobufjs": "7.6.5",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "build": "pnpm --filter @nyabase/common build && pnpm --filter @nyabase/frontend build && pnpm --filter @nyabase/backend build && pnpm --filter @nyabase/agent build",
    "build:agent-binary": "bash scripts/build-agent-binary.sh",
    "build:frontend": "pnpm --filter @nyabase/frontend build",
    "dev:backend": "pnpm --filter @nyabase/backend dev",
    "dev:frontend": "pnpm --filter @nyabase/frontend dev",
    "dev:agent": "pnpm --filter @nyabase/agent dev",
    "lint": "eslint packages/common/src packages/backend/src packages/agent/src packages/frontend/src",
    "typecheck": "pnpm --filter @nyabase/common build && pnpm --filter @nyabase/common typecheck && pnpm --filter @nyabase/backend typecheck && pnpm --filter @nyabase/agent typecheck && pnpm --filter @nyabase/frontend typecheck && pnpm --filter @nyabase/e2e typecheck",
    "test:unit": "pnpm --filter @nyabase/common test && pnpm --filter @nyabase/backend test && pnpm --filter @nyabase/agent test && pnpm --filter @nyabase/frontend test",
    "test": "pnpm typecheck && pnpm test:unit",
    "check": "bash scripts/check.sh",
    "check:agent-task": "bash scripts/check-agent-task-conformance.sh",
    "check:backend-bootstrap": "pnpm --filter @nyabase/common build && pnpm --filter @nyabase/backend build && node scripts/check-backend-bootstrap.mjs",
    "check:rust-proxies": "bash scripts/check-rust-proxies.sh",
    "e2e:validate": "pnpm --filter @nyabase/e2e validate",
    "e2e:preflight": "bash e2e/orchestrator/e2e.sh preflight",
    "e2e:doctor": "bash e2e/orchestrator/e2e.sh doctor",
    "e2e:build": "bash e2e/orchestrator/e2e.sh build",
    "e2e:up": "bash e2e/orchestrator/e2e.sh up",
    "e2e:health": "bash e2e/orchestrator/e2e.sh health",
    "e2e:down": "bash e2e/orchestrator/e2e.sh down",
    "test:e2e:smoke": "bash e2e/orchestrator/e2e.sh run smoke",
    "test:e2e:core": "bash e2e/orchestrator/e2e.sh run core",
    "test:e2e:full": "bash e2e/orchestrator/e2e.sh run full",
    "test:e2e:recovery": "bash e2e/orchestrator/e2e.sh run recovery",
    "test:e2e:release": "bash e2e/orchestrator/e2e.sh release"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
